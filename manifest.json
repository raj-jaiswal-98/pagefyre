{
  "manifest_version": 3,
  "name": "PageFyre — Here be dragons. On any webpage.",
  "version": "2.0.0",
  "description": "Turn any webpage into an illuminated grimoire battlefield! Summon mythic dragons, void beasts & mechas to burn, crush, and slice web elements, then restore reality with one click.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "themes/*",
        "content/*",
        "assets/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
