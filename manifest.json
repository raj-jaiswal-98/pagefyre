{
  "manifest_version": 3,
  "name": "Warzone Web Destroyer - Monsters & Dragons",
  "version": "1.0.0",
  "description": "Transform any website into an interactive warzone! Unleash Dragons, Darth Vader, Kaiju, Mechas & Eldritch horrors to destroy pages with realistic animations, physics, and monster battles.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/warzone.css"],
      "js": [
        "engine/sfx.js",
        "engine/physics.js",
        "engine/particles.js",
        "engine/dom-destroyer.js",
        "engine/monster-ai.js",
        "themes/monster-data.js",
        "content/warzone-hud.js",
        "content/content-main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "themes/*.json",
        "assets/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
